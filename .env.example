# ============================================================
# LinkedIn Auto-Publisher Pipeline — Environment Configuration
# Copy to .env and fill in your values before running.
# ============================================================

# General
ENVIRONMENT=development           # development | staging | production
TIMEZONE=Asia/Riyadh              # any valid pytz timezone string
LOG_LEVEL=INFO                    # DEBUG | INFO | WARNING | ERROR | CRITICAL
ENABLE_METRICS=true

# Storage
STORAGE_MODE=local                # local | s3 | gcs
LOCAL_CONTENT_DIR=./test_content/
AWS_S3_BUCKET=your-bucket-name
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Database
DATABASE_URL=postgresql://pipeline:pipeline@localhost:5433/pipeline

# LinkedIn OAuth2
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_REFRESH_TOKEN=
LINKEDIN_PROFILE_URN=urn:li:person:YOUR_PERSON_ID

# LLM
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5
LLM_MONTHLY_BUDGET=20.00

# Scheduling
DAILY_POST_LIMIT=3
POST_SLOTS=09:00,13:00,18:00      # comma-separated HH:MM times
APPROVAL_TIMEOUT_H=24
APPROVAL_REQUIRED=true

# Auto-publish: the folder watcher + background poller pick up files with no
# explicit API trigger. Keep this true until you deliberately want that path
# to publish live. Manual /pipeline/trigger calls have their own dry_run flag.
AUTO_PUBLISH_DRY_RUN=true

# Approval — Google Sheets + Slack
GOOGLE_SHEETS_CREDENTIALS_FILE=./credentials.json
GOOGLE_SHEET_ID=
SLACK_WEBHOOK_URL=
